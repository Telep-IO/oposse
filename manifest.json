{
  "schemaVersion": 1,
  "id": "telep.drops",
  "name": "Odropsy",
  "version": "0.3.1",
  "author": "telep",
  "license": "MIT AND Apache-2.0",
  "description": "All your personal assistants behind one bar icon: Muse, ChatGPT Dots and your Grok Bot roster. Whoever is waiting on you appears beside it; pick one and its chat drops down from the bar.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Assistants",
    "description": "One icon for every assistant. Those waiting on you show beside it as their own avatars; click for the list, click a row to drop that chat down.",
    "category": "AI",
    "aliases": [
      "drops",
      "assistants",
      "muse",
      "dots",
      "chatgpt",
      "grok",
      "grokbot",
      "omabot"
    ],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "services": "muse,dots,grok",
      "dotsUrl": "",
      "museUrl": "",
      "dotsAvatar": "",
      "museAvatar": "",
      "width": 480,
      "heightPercent": 60,
      "barMetric": "avatars",
      "ordering": "attention",
      "groupBySection": "true",
      "maxBarAvatars": 3,
      "museEyes": "",
      "dotsEyes": ""
    },
    "schema": [
      {
        "key": "services",
        "type": "string",
        "label": "Assistants to show",
        "defaultValue": "muse,dots,grok",
        "description": "Comma-separated: muse, dots, grok."
      },
      {
        "key": "dotsUrl",
        "type": "string",
        "label": "Your dot's URL (empty = Dots home)",
        "defaultValue": "",
        "description": "e.g. https://chatgpt.com/dots/<id>"
      },
      {
        "key": "museUrl",
        "type": "string",
        "label": "Muse URL (empty = muse.ai)",
        "defaultValue": ""
      },
      {
        "key": "dotsAvatar",
        "type": "string",
        "label": "Dots avatar image (empty = bundled)",
        "defaultValue": ""
      },
      {
        "key": "museAvatar",
        "type": "string",
        "label": "Muse avatar image (empty = bundled)",
        "defaultValue": ""
      },
      {
        "key": "dotsEyes",
        "type": "string",
        "label": "Dots avatar's eyes (with a custom avatar)",
        "defaultValue": "",
        "description": "Where the picture's eyes are, as fractions of it: lx,ly,rx,ry,width,height. Live eyes that follow the pointer are drawn there; empty = the picture turns instead."
      },
      {
        "key": "museEyes",
        "type": "string",
        "label": "Muse avatar's eyes (with a custom avatar)",
        "defaultValue": "",
        "description": "Where the picture's eyes are, as fractions of it: lx,ly,rx,ry,width,height. Live eyes that follow the pointer are drawn there; empty = the picture turns instead."
      },
      {
        "key": "width",
        "type": "integer",
        "label": "Dropdown width (px)",
        "min": 360,
        "max": 1200,
        "step": 20,
        "defaultValue": 480
      },
      {
        "key": "heightPercent",
        "type": "integer",
        "label": "Dropdown height (% of screen)",
        "min": 30,
        "max": 90,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "barMetric",
        "type": "enum",
        "label": "What sits beside the icon",
        "options": [
          "avatars",
          "count",
          "none"
        ],
        "defaultValue": "avatars",
        "description": "avatars = the assistants waiting on you, as themselves; count = how many; none = the icon alone."
      },
      {
        "key": "ordering",
        "type": "enum",
        "label": "Panel order",
        "options": [
          "attention",
          "channels",
          "flat"
        ],
        "defaultValue": "attention",
        "description": "attention = waiting on you first; channels = Assistants, then your Grok Bot sections; flat = by last message."
      },
      {
        "key": "groupBySection",
        "type": "boolean",
        "label": "Group the panel by section",
        "defaultValue": "true"
      },
      {
        "key": "maxBarAvatars",
        "type": "integer",
        "label": "Most avatars to show in the bar",
        "min": 1,
        "max": 6,
        "step": 1,
        "defaultValue": 3
      }
    ]
  }
}
