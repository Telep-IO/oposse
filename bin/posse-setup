#!/bin/bash
# posse-setup: get every assistant installed, running and signed in.
#
#   posse-setup          interactive: open each sign-in, report what it did
#   posse-setup --auto   from the widget on every shell start: quiet, only
#                        surfaces a window when something needs you
#
# What it does, per service in the `services` setting:
#   grok  install the grok-bot package if missing (a floating terminal runs
#         `omarchy pkg add grok-bot`, so sudo can ask for a password), then
#         start the app. Already signed in: it starts hidden, ready to drop
#         down. Never signed in on this machine: it starts on screen so you can.
#   muse  open the web app hidden; if the page is a sign-in page, bring it on
#   dots  screen. Signed in: it stays hidden, warmed up for the first click.
#
# Muse and Dots live in your default browser profile, so signing in here is the
# same session the dropdown uses. Grok Bot has its own login inside the app.

here=$(dirname "$(realpath "$0")")
toggle=$here/drop-toggle
state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/posse
mkdir -p "$state"
auto=0; [[ $1 == --auto ]] && auto=1

log() { (( auto )) && echo "posse-setup: $*" >&2 || echo "$*"; }

# One run at a time: the widget lives once per monitor and each copy asks.
# Long-lived children (the apps) must not inherit fd 9, or the lock outlives
# this run; drop-toggle closes it when launching.
exec 9>"$state/setup.lock"
flock -n 9 || { log "another setup is running"; exit 0; }

# The widget's settings are its bar entry in shell.json.
setting() { jq -r --arg k "$1" '[.bar.layout[][]?|select(.id=="telep.posse")][0][$k] // empty' \
  "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json" 2>/dev/null; }
services=$(setting services); [[ -n $services ]] || services=muse,dots,grok
services=${services//,/ }

grok_installed() { bash "$toggle" --grok-bin >/dev/null 2>&1; }
grok_running() { hyprctl clients -j | jq -e '.[]|select(.initialClass|test("grok-bot"))' >/dev/null 2>&1; }
grok_onboarded() { ls "$HOME/.config/Grok Bot/sand-client-persistence"/*.blob >/dev/null 2>&1; }

# The webapp's current window title; the sign-in pages give themselves away.
web_title() { # $1 service
  local re; case $1 in muse) re='muse\.ai' ;; dots) re='chatgpt\.com__dots' ;; esac
  hyprctl clients -j | jq -r --arg re "$re" '[.[]|select(.initialClass|test($re))][0].title // empty'
}
# Where a web app stands, by window title: in (signed in and loaded), out (a
# sign-in or landing page), or loading. Muse names the persona once loaded
# ("Chat — Felipe"); signed out it is the landing page ("Muse — Your Personal
# AI Agent"); while loading it is just "Muse". Dots says "ChatGPT" loaded or
# loading, so only an obvious sign-in page counts as out.
web_state() { # $1 service, $2 title
  case $1 in
    muse)
      [[ $2 =~ ^(\([0-9]+\)\ )?Chat ]] && { echo in; return; }
      [[ $2 =~ Personal|[Ll]og\ ?[Ii]n|[Ss]ign\ ?([Ii]n|[Uu]p)|[Aa]uth|[Ww]elcome|Platform ]] && { echo out; return; }
      echo loading ;;
    dots)
      [[ $2 =~ [Ll]og\ ?[Ii]n|[Ss]ign\ ?([Ii]n|[Uu]p)|[Aa]uth|[Ww]elcome|OpenAI ]] && { echo out; return; }
      [[ $2 == *ChatGPT* ]] && { echo in; return; }
      echo loading ;;
  esac
}

setup_grok() {
  if ! grok_installed; then
    if (( auto )); then
      log "installing grok-bot"
      omarchy-launch-floating-terminal-with-presentation "omarchy pkg add grok-bot" 9>&-
      for _ in $(seq 1 600); do grok_installed && break; sleep 1; done   # up to 10 min at the prompt
    else
      omarchy pkg add grok-bot
    fi
    grok_installed || { log "Grok Bot not installed; skipping (omarchy pkg add grok-bot)"; return; }
  fi
  if grok_running; then log "Grok Bot already running"; return; fi
  if grok_onboarded; then
    "$toggle" prelaunch grok && log "Grok Bot started (hidden)"
  else
    "$toggle" prelaunch grok && "$toggle" reveal grok && log "Grok Bot opened: sign in there"
  fi
}

setup_web() { # $1 service
  local svc=$1 url title
  url=$(setting "${svc}Url")
  "$toggle" prelaunch "$svc" "$url" || { log "$svc: could not open the web app (is a Chromium-based browser the default?)"; return; }
  # Give the page time to load and settle. A hidden window gets throttled by
  # the browser, so this can take a while; still loading at the end is left
  # hidden rather than shoved on screen (the next click shows it anyway).
  local st=loading
  for i in $(seq 1 240); do
    title=$(web_title "$svc"); st=$(web_state "$svc" "$title")
    [[ $st != loading ]] && (( i > 12 )) && break
    sleep 0.25
  done
  case $st in
    in) log "$svc ready (hidden): $title" ;;
    out) "$toggle" reveal "$svc" && log "$svc opened: sign in there (title: ${title:-none})" ;;
    *) log "$svc still loading after 60s, left hidden (title: ${title:-none})" ;;
  esac
}

for svc in $services; do
  case $svc in
    grok) setup_grok ;;
    muse|dots) setup_web "$svc" ;;
  esac
done

(( auto )) || cat <<MSG

Done. Anything that needed a sign-in is on screen; sign in and leave the window
(or close it). The bar icon drops each chat down from now on.
Allow notifications for chatgpt.com and muse.ai when the browser asks: that is
how Oposse knows a web chat replied.
MSG
